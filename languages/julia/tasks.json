[
  {
    "label": "julia test",
    "command": "julia",
    "args": [
      "--project=$ZED_WORKTREE_ROOT",
      "--startup-file=no",
      "--history-file=no",
      "-e",
      "'import Pkg; Pkg.test()'"
    ]
  },
  {
    "label": "Julia: Open Plot Pane",
    "command": "sh",
    "args": ["-c", "zed ~/.cache/zed-julia/current-plot.png"],
    "use_new_terminal": false,
    "reveal": "never"
  }
]
